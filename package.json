{
	"name": "@mythrantic/svelte-rich-text",
	"version": "1.1.0",
	"publishConfig": {
		"access": "public",
		"registry": "https://registry.npmjs.org/",
		"engine-strict": true
	},
	"description": "Rich text editor as a svelte component",
	"homepage": "https://svelte-rich-text.valiantlynx.com",
	"maintainers": [
		"valiantlynx <valiantlynxz@gmail.com> (https://www.valiantlynx.com/)"
	],
	"keywords": [
		"sveltekit",
		"rich text editor",
		"javascript",
		"typescript",
		"svelte",
		"blocks"
	],
	"author": {
		"name": "valiantlynx",
		"email": "valiantlynxz@gmail.com"
	},
	"contributors": [
		{
			"name": "valiantlynx",
			"email": "valiantlynxz@gmail.com"
		}
	],
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/mythrantic/svelte-rich-text.git"
	},
	"scripts": {
		"dev": "vite --host",
		"build": "vite build && yarn run package",
		"preview": "vite preview",
		"package": "svelte-kit sync && svelte-package && publint",
		"release": "pnpm run package && changeset publish",
		"ci:version": "pnpm changeset version",
		"ci:publish": "pnpm publish -r --no-git-checks",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test": "vitest",
		"lint": "prettier --plugin-search-dir . --check . && eslint .",
		"format": "prettier --plugin-search-dir . --write ."
	},
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"svelte": "./dist/index.js"
		}
	},
	"files": [
		"dist",
		"!dist/**/*.test.*",
		"!dist/**/*.spec.*"
	],
	"peerDependencies": {
		"svelte": "^5.0.0"
	},
	"devDependencies": {
		"@changesets/cli": "^2.29.8",
		"@fontsource/fira-mono": "^5.0.12",
		"@neoconfetti/svelte": "^2.2.1",
		"@sveltejs/adapter-auto": "^3.0.0",
		"@sveltejs/adapter-node": "^5.0.1",
		"@sveltejs/adapter-static": "^3.0.5",
		"@sveltejs/kit": "^2.10.0",
		"@sveltejs/package": "^2.0.0",
		"@sveltejs/vite-plugin-svelte": "^5.0.0",
		"@tailwindcss/postcss": "^4.0.0",
		"@types/eslint": "^8.56.0",
		"@typescript-eslint/eslint-plugin": "^6.0.0",
		"@typescript-eslint/parser": "^6.0.0",
		"autoprefixer": "^10.4.20",
		"dotenv": "^16.4.5",
		"eslint": "^8.56.0",
		"eslint-config-prettier": "^9.1.0",
		"eslint-plugin-svelte": "^2.35.1",
		"postcss": "^8.4.49",
		"postcss-load-config": "^4.0.1",
		"prettier": "^3.1.1",
		"prettier-plugin-svelte": "^3.1.2",
		"publint": "^0.1.9",
		"short-uuid": "^4.2.2",
		"svelte": "^5.14.6",
		"svelte-check": "^4.0.0",
		"svelte-select": "^5.7.0",
		"tailwindcss": "^4.0.0",
		"tslib": "^2.4.1",
		"typescript": "^5.0.0",
		"vite": "^7.3.0",
		"vite-plugin-devtools-json": "^1.0.0",
		"vitest": "^3.1.1"
	},
	"svelte": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"main": "dist/index.js",
	"type": "module",
	"typesVersions": {
		">4.0": {
			".": [
				"./dist/index.d.ts"
			]
		}
	},
	"dependencies": {
		"@floating-ui/dom": "^1.7.4",
		"@lucide/svelte": "^0.562.0",
		"@tiptap/core": "^3.13.0",
		"@tiptap/extension-bubble-menu": "^3.13.0",
		"@tiptap/extension-code-block-lowlight": "^3.13.0",
		"@tiptap/extension-highlight": "^3.13.0",
		"@tiptap/extension-image": "^3.13.0",
		"@tiptap/extension-list": "^3.13.0",
		"@tiptap/extension-mathematics": "^3.13.0",
		"@tiptap/extension-subscript": "^3.13.0",
		"@tiptap/extension-superscript": "^3.13.0",
		"@tiptap/extension-table": "^3.13.0",
		"@tiptap/extension-text-align": "^3.13.0",
		"@tiptap/extension-text-style": "^3.13.0",
		"@tiptap/extension-typography": "^3.13.0",
		"@tiptap/extensions": "^3.13.0",
		"@tiptap/markdown": "^3.13.0",
		"@tiptap/pm": "^3.13.0",
		"@tiptap/starter-kit": "^3.13.0",
		"@tiptap/suggestion": "^3.13.0",
		"katex": "^0.16.27",
		"lowlight": "^3.3.0",
		"svelte-tiptap": "^3.0.1",
		"tiptap-extension-auto-joiner": "^0.1.3"
	}
}
